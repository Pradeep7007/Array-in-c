#include<stdio.h>
int main(){
    int a,b,n;
    scanf("%d",&n);
    int arr[n];
    printf("Index: ");
    scanf("%d",&a);
    printf("Element: ");
    scanf("%d",&b);
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    for(int i=n;i>=a;i--){
        arr[i]=arr[i-1];
    }
    arr[a]=b;
    n++;
    for(int i=0;i<n;i++){
        printf("%d ",arr[i]);
    }
}
